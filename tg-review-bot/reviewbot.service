[Unit]
Description=Telegram Google Reviews Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замените на своего пользователя и реальный путь к проекту
User=ubuntu
WorkingDirectory=/home/ubuntu/tg-review-bot
ExecStart=/home/ubuntu/tg-review-bot/venv/bin/python3 /home/ubuntu/tg-review-bot/main.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntu/tg-review-bot/.env

[Install]
WantedBy=multi-user.target
